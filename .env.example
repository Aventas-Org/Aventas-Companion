# Aventas Desktop Companion - Environment Variables

# Application Mode
# Options: development, production, staging
VITE_APP_MODE=development

# Application Version
VITE_APP_VERSION=0.1.0

# API Configuration (for future use)
# VITE_API_BASE_URL=https://api.aventas.com
# VITE_API_TIMEOUT=30000

# Feature Flags (for future use)
# VITE_FEATURE_RIOT_INTEGRATION=false
# VITE_FEATURE_GAME_DETECTION=false
# VITE_FEATURE_OVERLAY=false

# Debug Mode
VITE_DEBUG=false

# Sentry / Error Tracking (for future use)
# VITE_SENTRY_DSN=